# Mainland-China deployment: use a Supabase instance self-hosted on approved China infrastructure.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.your-domain.example
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Backend only, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=replace-with-secret-or-service-role-key
# A verified domain belonging to the project. Students sign in with an opaque username.
STUDENT_LOGIN_DOMAIN=accounts.your-domain.example
# Background-worker secret, >=32 random characters.
WORKER_SECRET=replace-with-long-random-value
# Qwen-compatible image model hosted in a vetted China region; do not configure an overseas endpoint without a separate review.
MODEL_BASE_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=replace-with-api-key
MODEL_NAME=replace-with-enabled-vision-model
# Public site URL for CSRF origin checks
APP_ORIGIN=http://localhost:3000
